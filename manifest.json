{
    "manifest_version": 3,
    "name": "QuickSummarizer",
    "version": "0.2",
    "permissions": ["storage", "commands"],
    "host_permissions": [
        "https://generativelanguage.googleapis.com/*",
        "<all_urls>"
    ],
    "action": {
        "default_popup": "poptions.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["script.js"],
            "css": ["styles.css"]
        }
    ],
    "commands": {
        "toggle-extension": {
            "suggested_key": {
                "default": "Ctrl+Shift+S"
            },
            "description": "Toggle QuickSummarizer on/off"
        }
    }
}